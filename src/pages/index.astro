---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroSection from '../components/HeroSection.astro';
import MarqueeBand from '../components/MarqueeBand.astro';
import CitySection from '../components/CitySection.astro';
import FilmSection from '../components/FilmSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import FooterSection from '../components/FooterSection.astro';
import IntroOverlay from '../components/IntroOverlay.astro';
---

<Layout>
  <IntroOverlay />
  <Navbar />
  <main class="relative bg-deep-950">
    <HeroSection />
    <CitySection />
    <FilmSection />
    <MarqueeBand />
    <AboutSection />
    <ContactSection />
  </main>
  <FooterSection />
</Layout>

<script>
  import { translations, type Language } from '../i18n/translations';

  const meta = {
    es: {
      title: 'QORSU | Ciudades del futuro · Real Estate · Lujo · Turismo · Hospitalidad',
      description:
        'Qorsu, la vertical de Shepwashi para ciudades del futuro, real estate, lujo, turismo y hospitalidad. Infraestructura tecnológica para quienes construyen el futuro.',
    },
    en: {
      title: 'QORSU | Cities of the Future · Real Estate · Luxury · Tourism · Hospitality',
      description:
        "Qorsu, Shepwashi's vertical for cities of the future, real estate, luxury, tourism and hospitality. Technology infrastructure for those who build the future.",
    },
  };

  function resolveKey(obj: unknown, path: string): string | undefined {
    let current: unknown = obj;
    for (const part of path.split('.')) {
      if (current && typeof current === 'object' && part in (current as Record<string, unknown>)) {
        current = (current as Record<string, unknown>)[part];
      } else {
        return undefined;
      }
    }
    return typeof current === 'string' ? current : undefined;
  }

  function applyLang(lang: Language) {
    const dict = translations[lang];

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (!key) return;
      const value = resolveKey(dict, key);
      if (value !== undefined) el.textContent = value;
    });

    document.documentElement.lang = lang;
    document.title = meta[lang].title;
    const desc = document.querySelector<HTMLMetaElement>('meta[name="description"]');
    if (desc) desc.content = meta[lang].description;
  }

  function setupI18n() {
    const initialLang = (localStorage.getItem('qorsu_lang') as Language) || 'es';
    applyLang(initialLang);
  }

  document.addEventListener('DOMContentLoaded', setupI18n);
  document.addEventListener('astro:page-load', setupI18n);

  window.addEventListener('qorsu:lang-change', ((e: CustomEvent<{ lang: Language }>) => {
    applyLang(e.detail.lang);
  }) as EventListener);
</script>

<script>
  // Flow reveals: fire once on entry (content that re-hides on scroll-up is a defect).
  import { reduceMotion } from '../scripts/motion';

  const els = document.querySelectorAll<HTMLElement>('.reveal');
  if (reduceMotion) {
    els.forEach((el) => el.classList.add('revealed'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
</script>
