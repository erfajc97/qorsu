---
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QORSU | Ciudades del futuro • Lujo • Turismo • Hospitalidad',
  description = 'QORSU - La energía dorada que impulsa su propiedad y sus experiencias de lujo. Beyond agentic AI, at the service of all.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Favicon de estrella dorada Qorsu -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-forest-700 text-sage-300 antialiased selection:bg-gold-500/30 selection:text-gold-300">
    <slot />
  </body>
</html>
