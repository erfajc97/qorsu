---
import '../styles/index.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QORSU | Ciudades del futuro · Real Estate · Lujo · Turismo · Hospitalidad',
  description = 'Qorsu, la vertical de Shepwashi para ciudades del futuro, real estate, lujo, turismo y hospitalidad. Infraestructura tecnológica para quienes construyen el futuro.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#032724" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/art/bay-panorama.webp" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      // Decide on the intro before first paint: once per session, never under reduced motion.
      try {
        if (!sessionStorage.getItem('qorsu_intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('intro-active');
        }
      } catch (e) {}
    </script>
    <link rel="preload" as="image" href="/logo.png" />
    <link rel="preload" as="image" href="/art/hero-sky.webp" media="(min-width: 768px)" />
    <link rel="preload" as="image" href="/art/hero-sky-m.webp" media="(max-width: 767px)" />
  </head>
  <body class="bg-deep-950 text-mist-300 antialiased">
    <slot />
  </body>
</html>
