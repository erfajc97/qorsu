---
import { translations } from '../i18n/translations';
const t = translations.es;

// Fill these in to make the links live. Empty = rendered as plain text.
const socials = {
  instagram: '',
  linkedin: '',
};
---

<footer class="footer gutter">
  <img src="/logo.png" alt="QORSU" class="footer-sun" width="40" height="40" />

  <nav class="footer-links" aria-label="Qorsu">
    <a href={socials.instagram || undefined} target="_blank" rel="noopener">Instagram</a>
    <a href={socials.linkedin || undefined} target="_blank" rel="noopener">LinkedIn</a>
    <a href="mailto:hola@qorsu.com" data-i18n="footer.contact">{t.footer.contact}</a>
  </nav>

  <span class="footer-rule" aria-hidden="true"></span>

  <p class="footer-line">
    <span data-i18n="footer.before">{t.footer.before}</span>
    <span class="footer-brand">Shepwashi</span>
    <span data-i18n="footer.after">{t.footer.after}</span>
    <span class="footer-year">· 2026</span>
  </p>
</footer>

<style>
  .footer {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0;
    padding-bottom: clamp(2.5rem, 7vh, 4rem);
    background: var(--color-deep-950);
    text-align: center;
  }
  .footer-sun {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1.5rem, 4vw, 3rem);
  }
  .footer-links a {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    padding: 0.5rem 0;
    transition: color 0.3s;
  }
  .footer-links a[href]:hover {
    color: var(--color-gold-300);
  }
  .footer-rule {
    width: 6rem;
    height: 1px;
    background: var(--hairline);
  }
  .footer-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.55em;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-mist-500);
  }
  .footer-line span:empty {
    display: none;
  }
  .footer-brand {
    color: var(--color-gold-500);
  }
  .footer-year {
    color: var(--color-mist-300);
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .footer-links a {
      font-size: 0.72rem;
      letter-spacing: 0.26em;
    }
    .footer-line {
      font-size: 0.66rem;
      letter-spacing: 0.24em;
    }
  }
</style>
