---
import Logo from './Logo.astro';
---

<header
  id="site-header"
  class="site-header fixed top-0 z-50 w-full"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-5 py-4 sm:px-10 sm:py-6">
    <a href="#top" aria-label="Qorsu">
      <Logo size="responsive" />
    </a>

    <div
      class="flex items-center gap-1 p-1 rounded-full border border-white/15 bg-deep-950/45 shadow-[0_4px_18px_-6px_rgba(0,0,0,0.45)]"
      role="group"
      aria-label="Language Switcher"
    >
      <button
        type="button"
        data-lang="es"
        class="lang-toggle-btn min-h-9 px-3.5 sm:px-4 py-1.5 rounded-full font-sans text-xs tracking-[0.2em] transition-colors duration-300 cursor-pointer"
      >
        ES
      </button>
      <button
        type="button"
        data-lang="en"
        class="lang-toggle-btn min-h-9 px-3.5 sm:px-4 py-1.5 rounded-full font-sans text-xs tracking-[0.2em] transition-colors duration-300 cursor-pointer"
      >
        EN
      </button>
    </div>
  </div>
</header>

<style>
  .lang-active {
    background: rgba(201, 162, 75, 0.22);
    color: #EBD9A8;
    border: 1px solid rgba(201, 162, 75, 0.35);
    box-shadow: 0 0 14px rgba(201, 162, 75, 0.25);
  }
  .lang-idle {
    color: rgba(169, 196, 182, 0.75);
    border: 1px solid transparent;
  }
  .lang-idle:hover {
    color: #EDF4EE;
  }
  /* No bar: just the mark and the language pill floating over the page */
  .site-header {
    pointer-events: none;
  }
  .site-header :global(a),
  .site-header [role='group'] {
    pointer-events: auto;
  }
  .site-header :global(a) {
    filter: drop-shadow(0 1px 6px rgba(3, 39, 36, 0.6));
  }
</style>

<script>
  function updateLangUI(lang: 'es' | 'en') {
    document.querySelectorAll<HTMLButtonElement>('.lang-toggle-btn').forEach((btn) => {
      const isActive = btn.getAttribute('data-lang') === lang;
      btn.classList.toggle('lang-active', isActive);
      btn.classList.toggle('lang-idle', !isActive);
    });
  }

  function setupNavbar() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.lang-toggle-btn');
    const currentLang = (localStorage.getItem('qorsu_lang') as 'es' | 'en') || 'es';
    updateLangUI(currentLang);

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedLang = btn.getAttribute('data-lang') as 'es' | 'en';
        if (!selectedLang) return;
        localStorage.setItem('qorsu_lang', selectedLang);
        updateLangUI(selectedLang);
        window.dispatchEvent(
          new CustomEvent('qorsu:lang-change', { detail: { lang: selectedLang } })
        );
      });
    });

  }

  setupNavbar();

  window.addEventListener('qorsu:lang-change', ((e: CustomEvent<{ lang: 'es' | 'en' }>) => {
    updateLangUI(e.detail.lang);
  }) as EventListener);
</script>
