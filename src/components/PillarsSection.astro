---
import { translations } from '../i18n/translations';
const defaultLang = 'es';
const t = translations[defaultLang];
---

<section class="relative px-6 py-16 md:py-32 border-t border-gold-500/25 bg-forest-700 overflow-hidden">
  <!-- Fondo ambiental de lujo -->
  <div class="absolute bottom-0 left-1/3 w-[600px] h-[350px] rounded-full pointer-events-none bg-[radial-gradient(circle,rgba(201,162,75,0.08)_0%,transparent_70%)] blur-3xl"></div>

  <div class="max-w-7xl mx-auto flex flex-col gap-8 sm:gap-16 relative z-10">
    <!-- Encabezado con insignia de misión -->
    <div class="flex items-center gap-4">
      <div class="relative inline-block w-8 h-8">
        <img src="/logo.png" alt="Mission icon" class="w-full h-full object-contain" />
      </div>
      <span id="mission-badge" class="font-sans text-xs sm:text-sm tracking-[0.3em] uppercase text-sage-500 select-none">
        {t.missionBadge}
      </span>
    </div>

    <!-- Grid de 4 pilares en Glassmorphism de lujo -->
    <div id="pillars-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {t.pillars.map((pillar, index) => (
        <article
          class="group glass-card p-8 rounded-2xl border border-gold-500/15 border-t-2 border-t-gold-500 transition-all duration-500 hover:border-gold-400 hover:shadow-[0_15px_40px_rgba(201,162,75,0.22)] hover:-translate-y-2 flex flex-col justify-between gap-4 sm:gap-8"
          data-pillar-idx={index}
        >
          <div class="flex flex-col gap-5">
            <div class="flex items-center justify-between">
              <span class="font-sans text-xs tracking-[0.25em] uppercase text-gold-500 font-medium group-hover:text-gold-300 transition-colors">
                {pillar.badge}
              </span>
              <span class="w-8 h-px bg-gold-500/30 group-hover:w-12 group-hover:bg-gold-500 transition-all duration-300"></span>
            </div>

            <h3 class="pillar-title font-sans text-lg sm:text-xl tracking-[0.2em] uppercase gold-gradient-text">
              {pillar.title}
            </h3>
          </div>

          <p class="pillar-desc font-serif text-lg sm:text-xl leading-relaxed text-sage-400 group-hover:text-sage-200 transition-colors">
            {pillar.desc}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { translations, type Language } from '../i18n/translations';

  function updatePillarsLang(lang: Language) {
    const t = translations[lang];
    const missionEl = document.getElementById('mission-badge');
    if (missionEl) {
      missionEl.textContent = t.missionBadge;
    }

    const cards = document.querySelectorAll<HTMLElement>('[data-pillar-idx]');
    cards.forEach((card) => {
      const idxStr = card.getAttribute('data-pillar-idx');
      if (idxStr === null) return;
      const idx = parseInt(idxStr, 10);
      const pillarData = t.pillars[idx];
      if (!pillarData) return;

      const titleEl = card.querySelector('.pillar-title');
      const descEl = card.querySelector('.pillar-desc');

      if (titleEl) titleEl.textContent = pillarData.title;
      if (descEl) descEl.textContent = pillarData.desc;
    });
  }

  window.addEventListener('qorsu:lang-change', ((e: CustomEvent<{ lang: Language }>) => {
    updatePillarsLang(e.detail.lang);
  }) as EventListener);

  document.addEventListener('DOMContentLoaded', () => {
    const lang = (localStorage.getItem('qorsu_lang') as Language) || 'es';
    updatePillarsLang(lang);
  });
</script>
